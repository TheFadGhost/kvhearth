#compdef kvhearth-cli

_kvhearth_cli() {
  local -a commands
  commands=(
    'APPEND:append a value to a string key'
    'AUTH:authenticate with the server password'
    'BGSAVE:save a snapshot in the background'
    'CONFIG:get or set configuration parameters'
    'DEBUG:debugging commands (server-gated)'
    'DEL:delete keys'
    'ECHO:echo the given string'
    'EXEC:execute all queued transaction commands'
    'EXISTS:determine if keys exist'
    'EXPIRE:set a key time to live in seconds'
    'FLUSHALL:remove all keys'
    'GET:get the value of a string key'
    'GETRANGE:get a substring of a string value'
    'HDEL:delete hash fields'
    'HEXISTS:determine if a hash field exists'
    'HGET:get the value of a hash field'
    'HGETALL:get all fields and values of a hash'
    'HINCRBY:increment the integer value of a hash field'
    'HKEYS:get all fields in a hash'
    'HLEN:get the number of fields in a hash'
    'HSET:set hash field values'
    'HVALS:get all values in a hash'
    'INCR:increment the integer value of a key by one'
    'INCRBY:increment the integer value of a key'
    'INFO:get server information'
    'LASTSAVE:get the last snapshot save timestamp'
    'LINDEX:get an element from a list by index'
    'LLEN:get the length of a list'
    'LPUSH:prepend values to a list'
    'LRANGE:get a range of list elements'
    'LSET:set the value of a list element by index'
    'LTRIM:trim a list to a range'
    'MEMORY:inspect memory usage of a key'
    'MONITOR:stream all commands received by the server'
    'MULTI:start a transaction block'
    'PERSIST:remove the expiration from a key'
    'PING:ping the server'
    'PSUBSCRIBE:listen for messages matching patterns'
    'PUBLISH:post a message to a channel'
    'PUNSUBSCRIBE:stop listening for pattern messages'
    'RENAME:rename a key'
    'RESET:reset the connection state'
    'REWRITEAOF:rewrite the append log into minimal form'
    'RPUSH:append values to a list'
    'SAVE:save a snapshot synchronously'
    'SCAN:incrementally iterate the keyspace'
    'SADD:add members to a set'
    'SET:set the value of a string key'
    'SETRANGE:overwrite part of a string at an offset'
    'SINTER:intersect sets'
    'SISMEMBER:determine if a member is in a set'
    'SMEMBERS:get all members of a set'
    'SLOWLOG:inspect the slow operations log'
    'SREM:remove members from a set'
    'SUBSCRIBE:listen for messages on channels'
    'STRLEN:get the length of a string value'
    'SHUTDOWN:flush and close the server'
    'TYPE:determine the type of a key'
    'UNSUBSCRIBE:stop listening for channel messages'
    'UNWATCH:forget all watched keys'
    'WATCH:watch keys for changes before EXEC'
    'ZADD:add members to a sorted set'
    'ZCARD:get the number of members in a sorted set'
    'ZCOUNT:count members within a score range'
    'ZRANGE:return members within an index range'
    'ZRANGEBYSCORE:return members within a score range'
    'ZRANK:find the rank of a member'
    'ZREM:remove members from a sorted set'
    'ZSCORE:get the score of a member'
  )
  _describe 'command' commands
}

_kvhearth_cli "$@"
